# Regional FIPS host node — generated by ansible (role fips-blossom-cdn).
# region: {{ region }}
# Do not edit by hand.
#
# transports / tun / dns are at ROOT level. Do NOT nest them under `node:` —
# that silently yields `transports: 0` with no error.
node:
  identity:
    # Persisted by the daemon on first run: stable across reboots (GAP-7),
    # and no secret ever passes through Ansible.
    persistent: true
  discovery:
    nostr:
      enabled: true
      policy: configured_only
      app: "fips-overlay-v1"
      advertise: {{ (public_ip | default('')) | length > 0 }}

tun:
  enabled: true
  name: fips0
  mtu: 1280

dns:
  enabled: true
  bind_addr: "127.0.0.1"

transports:
  udp:
    bind_addr: "0.0.0.0:2121"
    advertise_on_nostr: true
  tcp:
    bind_addr: "0.0.0.0:8443"
{% if (public_ip | default('')) | length > 0 %}
    # REQUIRED for the TCP advert; without it FIPS warns every second and the
    # TCP endpoint is invisible on the overlay.
    external_addr: "{{ public_ip }}:8443"
{% endif %}
    advertise_on_nostr: true

# Static peers, when the region is pinned to specific neighbours. Empty by
# default: nostr discovery finds them.
peers: []
